# ============================================================
# qBittorrent
# ============================================================
QBIT_HOST=http://127.0.0.1:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=YOUR_QBIT_PASSWORD

# ============================================================
# Toloka
# ============================================================
TOLOKA_BASE_URL=https://toloka.to
TOLOKA_LOGIN_URL=https://toloka.to/login.php
TOLOKA_USERNAME=YOUR_TOLOKA_USERNAME
TOLOKA_PASSWORD=YOUR_TOLOKA_PASSWORD
RSS_URL=https://toloka.to/rss.php?t=1&c=12&f=127&toronly=1&lite=1&thumbs=1

# ============================================================
# Storage / qBittorrent categories
# ============================================================
# Root path for files managed by TrabBit.
SAVE_PATH=D:\Torent\Toloka
QBIT_BASE_PATH=D:\Torent\Toloka
TORRENT_LIMIT_GB=300
TORRENT_WARNING_GB=270
MANAGED_TAG=trabbit
IGNORE_TAG=trabbit-ignore
LEGACY_MANAGED_CATEGORIES=TolokaSeed

# ============================================================
# Automation
# ============================================================
AUTO_ADD_NEW=true
AUTO_UPDATE=true
WATCHLIST_AUTO_ADD=true
WATCHLIST_AUTO_UPDATE=true
READD_MISSING=false
DRY_RUN=false

# ============================================================
# Toloka network behaviour
# ============================================================
TOLOKA_REQUEST_DELAY=5.0
DEEP_RETAG_BATCH_SIZE=20
DEEP_RETAG_BATCH_PAUSE=30
TOLOKA_MAX_RETRIES=3
TOLOKA_MAX_CONSECUTIVE_429=2
REQUEST_TIMEOUT=30

# ============================================================
# Database / rules / debug
# ============================================================
DB_PATH=manager.db
RULES_PATH=config/rules.json
DEBUG_SAVE_HTML=true
DEBUG_DIR=debug
