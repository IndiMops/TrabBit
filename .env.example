# ============================================================
# qBittorrent
# ============================================================
QBIT_HOST=http://127.0.0.1:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=QBITTORENT_PASSWORD

# ============================================================
# Toloka
# ============================================================
TOLOKA_BASE_URL=https://toloka.to
TOLOKA_LOGIN_URL=https://toloka.to/login.php
TOLOKA_USERNAME=TOLOKA_USERNAME
TOLOKA_PASSWORD=TOLOKA_PASSWORD

# ============================================================
# RSS
# ============================================================
RSS_URL=https://toloka.to/rss.php?t=1&c=12&f=127&toronly=1&lite=1&thumbs=1

# ============================================================
# Torrents
# ============================================================
SAVE_PATH=YOUR_DOWNLOAD_PATH
QBIT_CATEGORY=TolokaSeed
TORRENT_LIMIT_GB=250

# ============================================================
# Automation
# ============================================================
AUTO_ADD_NEW=false
AUTO_UPDATE=false
DRY_RUN=true

# ============================================================
# Debug / network
# ============================================================
DEBUG_SAVE_HTML=true
DEBUG_DIR=debug
DB_PATH=manager.db
REQUEST_TIMEOUT=30
TOLOKA_REQUEST_DELAY=3.0
TOLOKA_MAX_RETRIES=3
TOLOKA_MAX_CONSECUTIVE_429=2

# ============================================================
# Watchlist
# ============================================================

# Add the first observed torrent version for watched topics
# automatically when the topic is first seen.
WATCHLIST_AUTO_ADD=false

# Add a new torrent version automatically when a watched topic changes.
WATCHLIST_AUTO_UPDATE=false
